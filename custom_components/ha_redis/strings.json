{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_service%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    },
    "step": {
      "user": {
        "title": "Connect to Redis",
        "description": "Enter the connection details for your Redis server.",
        "data": {
          "host": "Host",
          "port": "Port",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "host": "Hostname or IP address of the Redis server.",
          "port": "Port of the Redis server.",
          "username": "Redis ACL username. Leave empty to use the default user.",
          "password": "Password used for Redis authentication. Leave empty when no password is set."
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate Redis",
        "description": "Enter the new Redis ACL username and password for Redis server {name}. Leave the username empty to use the default user, and the password empty to connect without a password.",
        "data": {
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "username": "Redis ACL username. Leave empty to use the default user.",
          "password": "New Redis password. Leave empty when no password is set."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the Redis server.",
      "invalid_auth": "Authentication failed. Check the username and password.",
      "invalid_host": "Enter a valid hostname or IP address."
    }
  },
